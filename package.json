{
  "name": "@codebundlesbyvik/simple-maths-captcha",
  "version": "2.0.1",
  "description": "Easy to use, easy to solve CAPTCHA.",
  "keywords": [
    "simple",
    "maths",
    "captcha",
    "easy",
    "mathematics",
    "sum",
    "challenge",
    "anti spam",
    "robot",
    "module",
    "esm"
  ],
  "license": "MPL-2.0",
  "author": "codebundlesbyvik",
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vikputthiscodeongit/simple-maths-captcha.git"
  },
  "bugs": "https://github.com/vikputthiscodeongit/simple-maths-captcha/issues",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "lint-fix": "eslint --fix",
    "compile": "tsc",
    "minify": "terser dist/index.js --output dist/index.js --compress drop_console=[debug,log,info],ecma=2022,module=true,passes=2",
    "build": "npm run lint-fix && rimraf dist && cross-env NODE_ENV=production npm run compile && npm run minify"
  },
  "dependencies": {
      "@codebundlesbyvik/js-helpers": "^2.1.5",
      "@codebundlesbyvik/ntp-sync": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tsconfig/recommended": "^1.0.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "engines": {
    "node": ">=12.22.0"
  }
}
